define SensorType 1076425094
define HydroType 1441767298
define SensorName HASH("GLDLSNSR")
define HydroName HASH("GLHPSTN")
define DayMinutes 20
define LightMinutes 12.5
main:
sbn SensorType SensorName Mode 0
lbn r0 SensorType SensorName ReferenceId Maximum
sgtz r0 r0
lbn r1 SensorType SensorName SolarAngle Maximum
mul r2 LightMinutes 180
div r2 r2 DayMinutes
slt r3 r1 r2
and r3 r3 r0
sbn HydroType HydroName On r3
yield
j main
